APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Producción debe servirse por HTTPS. Los tokens Bearer viajan en cada request;
# sobre HTTP plano un atacante en la LAN puede capturarlos.
APP_URL=https://sgeq.utamed.uta.cl

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ============================
# BASE DE DATOS (MariaDB)
# ============================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reserva_de_equipo
DB_USERNAME=reserva_user
DB_PASSWORD=

# ============================
# CACHE / SESSION / QUEUE
# ============================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Solo enviar cookies de sesión por conexiones HTTPS.
SESSION_SECURE_COOKIE=true

# Vida útil de los tokens de API (Sanctum) en minutos. 480 = 8 horas.
SANCTUM_TOKEN_EXPIRATION=480

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================
# MAIL (GMAIL SMTP)
# ============================
MAIL_MAILER=smtp
MAIL_HOST=smtp.googlemail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ============================
# GOOGLE AUTH (PRODUCCIÓN)
# ============================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sgeq.utamed.uta.cl/auth/google/callback
FRONTEND_URL=https://sgeq.utamed.uta.cl

# ============================
# AWS (NO USADO POR AHORA)
# ============================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================
# PUSHER (NO USADO)
# ============================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================
# SSO CON UTAMED
# ============================
# UTAmed firma un token con la identidad de la persona y SGEQ lo verifica con la
# clave publica. Solo la publica: SGEQ verifica, nunca emite.
#
# Copiar el archivo que entrega UTAmed a storage/app/sso/ (fuera del repositorio):
#   scp utamed-sso-public.pem servidor:/ruta/Backend/storage/app/sso/
#
# Deben coincidir exactamente con SGEQ_SSO_ISSUER / SGEQ_SSO_AUDIENCE en UTAmed.
UTAMED_SSO_ISSUER=utamed
UTAMED_SSO_AUDIENCE=sgeq

# Por defecto storage/app/sso/utamed-sso-public.pem; definir solo para otra ruta.
# UTAMED_SSO_PUBLIC_KEY_PATH=

# Pantalla del SPA que recibe el ticket. Por defecto FRONTEND_URL + /auth/sso-callback.
# UTAMED_SSO_FRONTEND_CALLBACK_URL=
